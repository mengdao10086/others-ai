# dex2oat-boost 配置（改完重启生效）
# 测试用 D2O_ 前缀环境变量可覆盖同名项。

POLL_INTERVAL=5
APP_ROOT=/data/app

# 持久状态（state.tsv / queue.tsv）默认放在模块 bin/ 下；日志与临时文件放 CACHE_DIR
CACHE_DIR=/cache

# ① 安装期降档
DOWNGRADE_ENABLE=1
INSTALL_FILTER=skip
DOWNGRADE_REASONS="install install-fast install-bulk install-bulk-downgraded install-bulk-secondary install-bulk-secondary-downgraded install-create-dm"

# ② 装后补编译
RECOMPILE_FILTER=speed
# 1=加 -f 强制重编译；0=让系统自行判断
RECOMPILE_FORCE=0
# 检测到新装后等待几个周期再编译；期间再来新装会重置倒计时
START_DELAY_CYCLES=3

# ③ 动态并行
MAX_PARALLEL=3
CPU_CORE_SET=4-7
CPU_LOAD_THRESHOLD=50

# ④ 就绪 / 重试
READY_CHECK=1
COMPILE_RETRY_MAX=3
PENDING_MAX_CYCLES=120

# 日志体积上限与轮转保留行数
MAX_LOG_BYTES=262144
LOG_KEEP_LINES=400

# 1=只记录不执行（离线自测）
DRY_RUN=0
