# dex2oat-boost 模块配置（纯 root）
# 改完重启生效（或重新插拔模块后重启）。字段含义见模块 README.md。
# 本文件由 bin/dex2oat-boost-daemon.sh 载入；测试用 D2O_ 前缀环境变量可临时覆盖。

# 轮询间隔（秒）
POLL_INTERVAL=5

# 扫描根目录（正常无需改；测试时可指向沙箱目录）
APP_ROOT=/data/app

# 工作目录（存基线状态 state.tsv、退避 pending.tsv、日志）
WORKDIR=/data/adb/dex2oat-boost

# ① 安装期降档
#   DOWNGRADE_ENABLE=1 时，开机把下列每个 pm.dexopt.<reason> 置为 INSTALL_FILTER
#   DOWNGRADE_REASONS 默认只含交互式安装的 install 与 install-fast；
#   批量/恢复安装的 install-bulk* 默认不动（装后守护仍会把它们重编译为 speed），
#   如确需一并降档，可自行追加，如 "install install-fast install-bulk"
DOWNGRADE_ENABLE=1
INSTALL_FILTER=verify
DOWNGRADE_REASONS="install install-fast"

# ② 装后重编译到的编译档
RECOMPILE_FILTER=speed

# 编译失败重试上限（次）；未就绪等待上限（轮，1 轮=POLL_INTERVAL 秒）
COMPILE_RETRY_MAX=6
PENDING_MAX_CYCLES=120

# 日志体积上限（字节）与轮转保留行数
MAX_LOG_BYTES=262144
LOG_KEEP_LINES=400

# 调试开关：1=只记录不执行（属性写入与编译都不做），用于离线自测
DRY_RUN=0
